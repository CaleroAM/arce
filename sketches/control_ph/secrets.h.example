// Copia este archivo como secrets.h (NO lo subas a git).
#pragma once
#define BLYNK_TEMPLATE_ID   "TMPLxxxxxxxx"
#define BLYNK_TEMPLATE_NAME "Control pH ARCE"
#define BLYNK_AUTH_TOKEN    "pon_aqui_el_token"
#define WIFI_SSID           "tu_red_2_4GHz"
#define WIFI_PASS           "tu_password"

// Datastreams (Virtual Pin) a crear en la plantilla de blynk.cloud:
//  V0 pH            double  0-14   2 decimales   (gauge; el color lo cambia el firmware)
//  V1 umbral        double  4.5-7  paso 0.1      (slider, escribe la app)
//  V2 dosificar     integer 0-1                  (switch, escribe la app; el firmware lo regresa a 0 al terminar)
//  V3 estado        string                       (REPOSO / DOSIFICANDO / MEZCLANDO)
//  V4 voltaje       double  0-3.3  3 decimales
//  V5 bomba         integer 0-1                  (LED)
//  V6 dosis_mL      double  0-100  1 decimal
//  V7 color         string                       (#RRGGBB, para el widget HTML)
//  V8 mensaje       string                       (último evento)
//  V9 temp_V        double  0-3.3                (salida To de la sonda, sin calibrar)
// Eventos: dosificacion_inicio, dosificacion_fin, dosificacion_error, dosificacion_rechazada
